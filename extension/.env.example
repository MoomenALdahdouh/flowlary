# Flowlary extension — optional Vite overrides (copy to extension/.env.local)

# Unified Flowlary API (default dev: https://writing-api.test via Herd)
VITE_FLOWLARY_API_URL=https://writing-api.test
# Direct HTTP fallback if Herd TLS is unavailable:
# VITE_FLOWLARY_API_URL=http://127.0.0.1:8787

# Marketing site for sign-in / pricing links (default: https://flowlary.test)
VITE_FLOWLARY_SITE_URL=https://flowlary.test

# Legacy overrides (deprecated — prefer VITE_FLOWLARY_API_URL)
# VITE_TRANSLATION_API_URL=
# VITE_LAYOUT_API_URL=
