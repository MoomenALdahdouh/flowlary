# Flowlary AI Gateway — local development
# Copy to backend/.env and load before `npm run dev:api`

FLOWLARY_ENV=development
PORT=8787

# Managed Groq credential (server only — never commit real keys)
GROQ_API_KEY=

# Development auth (disabled automatically when FLOWLARY_ENV=development)
FLOWLARY_AUTH_DISABLED=1
FLOWLARY_EXTENSION_AUTH_SECRET=change-me-in-staging-production

# Optional tuning
FLOWLARY_AI_TIMEOUT_MS=30000
FLOWLARY_MAX_BODY_BYTES=64000
