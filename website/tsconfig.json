{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@flowlary/layout-repair": ["../extension/src/core/engine/layoutSequence.ts"],
      "@flowlary/layout-registry": ["../extension/src/features/layout/layouts/registry.ts"]
    }
  },
  "include": [
    "src",
    "../extension/src/core/engine/layoutSequence.ts",
    "../extension/src/features/layout/layouts/registry.ts"
  ],
  "exclude": ["src/__tests__"]
}
