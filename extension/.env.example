# Flowlary extension — environment files are not used for API targeting.

# Choose the API with npm scripts instead:
#   npm run build:ext:local        → http://127.0.0.1:8787
#   npm run build:ext:production   → https://api.flowlary.com
#   npm run build:release          → production API + store manifest
#
# Do not set VITE_FLOWLARY_API_URL here. Vite ignores this directory's
# leftover .env.local for API/site hosts.
