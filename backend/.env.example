# Flowlary AI Gateway — local development
# Copy to backend/.env and load before `npm run dev:api`

FLOWLARY_ENV=development
PORT=8787
# Bind address (Docker/PM2 usually 0.0.0.0)
# HOST=0.0.0.0

# Opt-in NDJSON debug file (never in production). Unset = no file writes.
# FLOWLARY_AGENT_DEBUG_LOG=

# Managed Groq credential (server only — never commit real keys)
GROQ_API_KEY=

# Writing review (span edits). Failure-only Groq → Gemini → OpenRouter.
# Does not write fields; the extension re-ingests candidates.
WRITING_REVIEW_ENABLED=1
WRITING_REVIEW_FALLBACK_ENABLED=1
WRITING_REVIEW_TIMEOUT_MS=4500

# (rank hypothesis IDs only). Local layout still writes immediately.
# Providers never mutate the DOM.
ADVISOR_ENABLED=1
AI_ADVISOR_PROVIDER_ORDER=groq,gemini,openrouter
GROQ_ADVISOR_ENABLED=1
GROQ_ADVISOR_MODEL=openai/gpt-oss-20b
# gpt-oss-20b needs room for reasoning tokens before JSON. 180 fails live.
GROQ_ADVISOR_MAX_TOKENS=512
# 1500ms is the safe default. Use ~6000 locally if Gemini/OpenRouter fallback
# should have time after Groq (each live rank is often ~1s).
ADVISOR_TOTAL_DEADLINE_MS=1500
ADVISOR_USER_RPM=30
ADVISOR_GLOBAL_RPM=60
ADVISOR_MAX_PROVIDER_ATTEMPTS=3
ADVISOR_MAX_FALLBACKS=2
GROQ_ADVISOR_RPM=60
GEMINI_ADVISOR_RPM=60
OPENROUTER_ADVISOR_RPM=60
ADVISOR_FALLBACK_MIN_REMAINING_MS=100

# Failure-only fallback. Defaults stay off for safe production deploys.
# Enable locally once Groq, Gemini, and OpenRouter credentials + model are set.
ADVISOR_FALLBACK_ENABLED=0
GEMINI_ADVISOR_ENABLED=0
GEMINI_ADVISOR_MODEL=gemini-3.5-flash-lite
GEMINI_ADVISOR_MAX_TOKENS=512
GEMINI_API_KEY=

# OpenRouter is one gateway provider from Flowlary's perspective. The model is
# required when the adapter is enabled. openai/gpt-4o-mini is the live-checked
# ranking model; keep reasonCode/ambiguityClass as snake_case tokens.
OPENROUTER_ADVISOR_ENABLED=0
OPENROUTER_ADVISOR_MODEL=openai/gpt-4o-mini
OPENROUTER_ADVISOR_MAX_TOKENS=512
OPENROUTER_API_KEY=

# Development auth (disabled automatically when FLOWLARY_ENV=development)
FLOWLARY_AUTH_DISABLED=1
FLOWLARY_EXTENSION_AUTH_SECRET=change-me-in-staging-production

# JWT signing (defaults to FLOWLARY_EXTENSION_AUTH_SECRET if unset)
FLOWLARY_JWT_SECRET=change-me-in-staging-production

# Comma-separated test accounts that bypass AI credit limits (development only).
# FLOWLARY_UNLIMITED_TEST_EMAILS=demo@flowlary.test

# Persistent store (accounts, sessions, usage). JSON file — single process.
# FLOWLARY_DATA_PATH=./data/flowlary-store.json

# Production CORS (no wildcards). Development also allows local website origins.
# FLOWLARY_CORS_ORIGINS=https://flowlary.com,https://www.flowlary.com
FLOWLARY_AI_TIMEOUT_MS=30000
FLOWLARY_MAX_BODY_BYTES=64000

# Mailpit / SMTP (local development: SMTP_HOST=127.0.0.1 SMTP_PORT=1025)
SMTP_HOST=
SMTP_PORT=1025
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Flowlary <noreply@flowlary.local>

# Public website origin for email verification links (no trailing slash)
# Local Herd: https://flowlary.test — Production: https://flowlary.com
FLOWLARY_WEB_ORIGIN=https://flowlary.test

# Paddle Billing (server only — never put these in the extension or website bundle)
# Development: sandbox. Production live billing requires PADDLE_ENVIRONMENT=production
# plus live key, live price, live webhook destination, and live secret.
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# Alias accepted: PADDLE_NOTIFICATION_WEBHOOK_SECRET
PADDLE_CLIENT_TOKEN=
# Sandbox catalog: Flowlary Pro monthly at $4.99 (499 cents) — create in Paddle and paste price ID
PADDLE_PRICE_ID_PRO=
# Sandbox catalog: Flowlary Pro yearly at $39 (3900 cents) — create in Paddle and paste price ID
PADDLE_PRICE_ID_PRO_YEARLY=

# Google Cloud Translation (server only — never put these in the extension or website)
# Enable with GOOGLE_TRANSLATE_ENABLED=1 once credentials are configured.
GOOGLE_TRANSLATE_ENABLED=0
GOOGLE_PROJECT_ID=
GOOGLE_LOCATION=global
# ADC path for v3 API (preferred in production)
GOOGLE_APPLICATION_CREDENTIALS=
# Optional API key for Translation API v2 (local/dev alternative to ADC)
GOOGLE_TRANSLATE_API_KEY=
# Force provider for migration/testing: auto | google | groq | google_then_groq
TRANSLATION_FORCE_PROVIDER=auto
# When 1, Free Google failures may fall back to Groq (credit-gated, observable)
TRANSLATION_ALLOW_GROQ_FALLBACK=0

# Voice of Customer / feedback (comma-separated admin emails; optional store URLs)
FLOWLARY_FEEDBACK_ADMIN_EMAILS=
CHROME_WEB_STORE_URL=
EDGE_ADDONS_URL=

# Verified external store ratings (manual — never scraped)
# CHROME_STORE_RATING=4.8
# CHROME_STORE_REVIEW_COUNT=120
# CHROME_STORE_RATING_VERIFIED_AT=1735689600000
# EDGE_STORE_RATING=
# EDGE_STORE_REVIEW_COUNT=
# EDGE_STORE_RATING_VERIFIED_AT=
# FLOWLARY_PUBLIC_STATS_ENABLED=1
# FLOWLARY_PUBLIC_SHOW_REGISTERED_USERS=1
